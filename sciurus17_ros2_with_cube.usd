                hide_in_stage_window = true
                no_delete = true
            )
            {
                rel camera = </World/sciurus17_ros2/sciurus17/neck_pitch_link/head_camera_link/head_camera_color_frame/head_camera_color_optical_frame/head_camera>
                token omni:rtx:background:source:texture:textureMode = "repeatMirrored"
